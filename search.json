---
layout: null
permalink: /search.json
---
[
{% assign sorted = site.articles | sort: "date" | reverse %}
{%- for a in sorted -%}
  {
    "title": {{ a.title | jsonify }},
    "url": {{ a.url | relative_url | jsonify }},
    "date": {{ a.date | date: "%b %-d, %Y" | jsonify }},
    "excerpt": {{ a.excerpt | strip_html | strip_newlines | jsonify }},
    "categories": {{ a.categories | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
