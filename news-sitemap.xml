---
layout: null
permalink: /news-sitemap.xml
---
{%- comment -%}
  Google News sitemap. Per spec it includes only articles published in the
  last 2 days (172800 seconds). Submit this URL in Google Search Console as
  a "News sitemap" — different from the regular /sitemap.xml.
{%- endcomment -%}
{%- assign cutoff = site.time | date: "%s" | minus: 172800 -%}
{%- assign recent = site.articles
    | sort: "date"
    | reverse
-%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
{%- for article in recent -%}
  {%- assign article_seconds = article.date | date: "%s" | plus: 0 -%}
  {%- if article_seconds >= cutoff -%}
  <url>
    <loc>{{ article.url | absolute_url }}</loc>
    <news:news>
      <news:publication>
        <news:name>{{ site.title | xml_escape }}</news:name>
        <news:language>en</news:language>
      </news:publication>
      <news:publication_date>{{ article.date | date_to_xmlschema }}</news:publication_date>
      <news:title>{{ article.title | xml_escape }}</news:title>
    </news:news>
  </url>
  {%- endif -%}
{%- endfor %}
</urlset>
